# =========================
# 1. 深度学习与图像数据 (核心)
# =========================
# 忽略你用于训练和测试的大型数据集文件夹
data/
datasets/
dataset/

# 忽略具体的图像文件（如果它们不在 data 文件夹里）
*.jpg
*.jpeg
*.png
*.tif
*.tiff

# 忽略训练产生的巨大模型权重文件
*.pth
*.pt
*.h5
*.onnx
*.weights
*.ckpt

# 忽略训练过程的日志文件 (如 TensorBoard)
logs/
runs/
wandb/

# =========================
# 2. Python 与虚拟环境
# =========================
# 忽略 Python 运行时生成的缓存文件
__pycache__/
*.py[cod]
*$py.class

# 忽略虚拟环境文件夹 (如果你用的话)
.venv/
venv/
env/
.env

# =========================
# 3. 编辑器与系统文件
# =========================
# 忽略 VS Code 的本地工作区设置
.vscode/
*.code-workspace

# 忽略 Jupyter Notebook 的自动保存缓存
.ipynb_checkpoints/

# 忽略 Mac 或 Windows 系统自动生成的垃圾文件
.DS_Store
Thumbs.db
